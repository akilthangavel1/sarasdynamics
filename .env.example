# ==============================================================================
# Saras Dynamics — Environment Configuration Template
# Copy this file to .env and configure your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Runtime & Environment
# ------------------------------------------------------------------------------
# Options: development | production | test (Default: development)
NODE_ENV=development
PORT=3000

# CORS Allowed Origins
# In Production: MUST be an explicit origin or comma-separated list of origins. Wildcards (*) are forbidden.
# Example: CORS_ORIGIN=https://sarasdynamics.com,https://admin.sarasdynamics.com
# In Development: Defaults to localhost:3000, localhost:5173
CORS_ORIGIN=

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# In Development/Test: Defaults to 'sqlite' with local file at server/data/dev.db
# In Production: MUST be 'postgresql' and DATABASE_URL is REQUIRED.
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./server/data/dev.db

# Production PostgreSQL Example:
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://saras_user:your_secure_password@db.example.com:5432/saras_dynamics_prod

# ------------------------------------------------------------------------------
# 3. Firebase Admin SDK (Backend Authentication & Token Verification)
# ------------------------------------------------------------------------------
# Required in Production for server-side ID token verification.
# Obtained from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Development Auth Bypass (dev-test tokens)
# STRICTLY FORBIDDEN and automatically rejected in production (NODE_ENV=production).
# Set to 'true' only for local offline developer testing without Firebase credentials.
ALLOW_DEV_AUTH=false

# Optional bootstrap Super Admin email during initial database seeding
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# ------------------------------------------------------------------------------
# 4. Firebase Web Client SDK (Frontend Application)
# ------------------------------------------------------------------------------
# Obtained from Firebase Console > Project Settings > General > Your Apps (Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional Frontend API Base URL (Defaults to relative '/api')
VITE_API_URL=/api

# ------------------------------------------------------------------------------
# 5. AWS S3 Storage (Candidate Resumes & Blog Featured Images)
# ------------------------------------------------------------------------------
# Bucket name and region are REQUIRED in Production.
# If running on AWS EC2 / ECS / EKS with IAM Roles, access keys can be left empty.
AWS_REGION=us-east-1
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# File upload size limits & presigned URL TTL
MAX_RESUME_SIZE_MB=5
MAX_BLOG_IMAGE_SIZE_MB=5
S3_PRESIGNED_EXPIRES_IN=900

# ------------------------------------------------------------------------------
# 6. Platform Injected Secrets & App URLs
# ------------------------------------------------------------------------------
# Injected at runtime by Google AI Studio / Cloud Run
GEMINI_API_KEY=
APP_URL=


