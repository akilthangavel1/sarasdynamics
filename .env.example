# Server & Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
# Development uses SQLite (local file automatically created at server/data/dev.db)
# Production uses PostgreSQL (supply full connection URL)
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./server/data/dev.db

# Production PostgreSQL example:
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://user:password@localhost:5432/saras_dynamics

# Firebase Admin SDK (Backend Server)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
ALLOW_DEV_AUTH=false

# Firebase Web Client SDK (Frontend)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# AWS S3 (Resumes & Documents & Blog Images)
AWS_REGION=us-east-1
S3_BUCKET_NAME=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_RESUME_SIZE_MB=5
MAX_BLOG_IMAGE_SIZE_MB=5
S3_PRESIGNED_EXPIRES_IN=900

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

